# Copie este arquivo para .env e preencha com os seus valores.
# O arquivo .env NUNCA deve ir para o GitHub (já está no .gitignore).

# Conexão com o MySQL. Recomendado: um usuário próprio da aplicação, não o root.
DATABASE_URL=mysql+pymysql://usuario_app:sua-senha-forte@localhost:3306/biblioteca_mangas

# Chave usada para assinar os tokens de login. Gere uma nova com:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=troque-por-uma-chave-gerada-com-o-comando-acima

# Tempo de validade do login, em minutos.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Endereços do front-end autorizados a chamar a API (separados por vírgula).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
