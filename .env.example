# Usado pelo docker compose. Copie para .env (na raiz do projeto) e preencha.
# O arquivo .env NUNCA deve ir para o GitHub (já está no .gitignore).

# Chave usada para assinar os tokens de login. Gere uma nova com:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Chave do servidor MCP em /mcp (opcional; sem ela o MCP fica desligado).
# MCP_API_KEY=

# Senhas do MySQL do container (opcional: sem elas são usados valores de desenvolvimento).
# MYSQL_PASSWORD=
# MYSQL_ROOT_PASSWORD=
